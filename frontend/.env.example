# Browser-safe URLs. Use one hostname consistently: this project uses 127.0.0.1.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:5001

# Server-only settings for Next.js Route Handlers. Never prefix these with NEXT_PUBLIC_.
# Keep this file local as .env.local; it is ignored by Git.
CPSM_API_INTERNAL_URL=http://127.0.0.1:5001/api/v1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback