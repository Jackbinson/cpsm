PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cspm_project
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me

# Discord Bot
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CLIENT_ID=

# AWS real account
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is only needed for temporary credentials.
AWS_SESSION_TOKEN=

# Leave this empty for real AWS.
# Use http://localhost:4566 for LocalStack when running outside Docker.
# Use http://localstack:4566 for LocalStack inside Docker Compose.
AWS_ENDPOINT=
DISCORD_ENABLED=false
