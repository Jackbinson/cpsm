PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cspm_project
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Google Sign-In. This is the public OAuth Client ID, not the Client Secret.
GOOGLE_OAUTH_CLIENT_ID=
# Comma-separated local origins allowed to call the API.
FRONTEND_ORIGIN=http://127.0.0.1:3001,http://localhost:3001
# Optional; required only to enable the one-time /create-admin endpoint.
BOOTSTRAP_ADMIN_SECRET=

# Discord Bot
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CLIENT_ID=

# AWS real account
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is only needed for temporary credentials.
AWS_SESSION_TOKEN=

# Leave this empty for real AWS.
# Use http://localhost:4566 for LocalStack when running outside Docker.
# Use http://localstack:4566 for LocalStack inside Docker Compose.
AWS_ENDPOINT=
DISCORD_ENABLED=false

# Async cloud scan queue
SCAN_CONCURRENCY=2
SCAN_TIMEOUT_MS=600000
SCAN_MAX_ATTEMPTS=4
SCAN_BACKOFF_MS=5000
SCAN_CANCEL_POLL_MS=1000

# Structured JSON logs (read with docker compose logs -f backend/worker)
LOG_LEVEL=info
LOG_SERVICE_NAME=cpsm-api
LOG_INCLUDE_STACK=true
